DOUJOY_PORT=4310
DOUJOY_BIND_IP=127.0.0.1
DOUJOY_CORS_ORIGIN=http://localhost:8081
DOUJOY_TURN_TIMEOUT_MS=45000
DOUJOY_BOT_THINK_MIN_MS=1200
DOUJOY_BOT_THINK_MAX_MS=2200
DOUJOY_BACKUP_COUNT=3
DOUJOY_WAIT_TIMEOUT_MAX_MS=25000
# 仅当服务端位于覆盖 X-Forwarded-For 的受控反向代理后方时启用。
DOUJOY_TRUST_PROXY=false
DOUJOY_WEB_PORT=8081
DOUJOY_WEB_BIND_IP=127.0.0.1
DOUJOY_WEB_UPSTREAM=http://127.0.0.1:4310
DOUJOY_WEB_UPSTREAM_TIMEOUT_MS=35000
# 仅当 Web 前方还有会覆盖 X-Forwarded-For 的受控 HTTPS 代理时启用。
DOUJOY_WEB_TRUST_PROXY=false
# disabled（默认）不会创建订单；sandbox 只写本地模拟订单，绝不调用真实 CloudPay。
DOUJOY_CLOUDPAY_MODE=disabled
# 仅在 sandbox 模式使用；它不是生产支付账本。
DOUJOY_CLOUDPAY_SANDBOX_DATA_PATH=/data/cloudpay-sandbox-orders.json
# 研究模式 VLM；默认关闭。不要把 API key 提交到仓库。
DOUJOY_VLM_MODE=disabled
DOUJOY_VLM_URL=http://127.0.0.1:4420
DOUJOY_VLM_TIMEOUT_MS=30000
# DOUJOY_VLM_API_KEY=replace-with-a-secret
EXPO_PUBLIC_DOUJOY_API_URL=http://192.168.1.10:4310
